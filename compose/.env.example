# Copy to .env and change every CHANGE-ME value.
# Check https://hub.docker.com/_/nextcloud for the newest NN-apache tag before the first install.
# Never change the Nextcloud major version later without reading the upgrade docs.
NEXTCLOUD_IMAGE=nextcloud:34-apache
MARIADB_IMAGE=mariadb:11.4
NGINX_IMAGE=nginx:stable-alpine
# Test VM: 0.0.0.0   EC2 instance: 10.8.0.1 (the VPN address only)
BIND_IP=0.0.0.0
DATA_DIR=/srv/nextcloud
# Test VM: https://127.0.0.1:8443   EC2 instance: https://10.8.0.1
OVERWRITE_CLI_URL=https://127.0.0.1:8443
# Space-separated. Test VM: 127.0.0.1 localhost   EC2 instance: 10.8.0.1
TRUSTED_DOMAINS=127.0.0.1 localhost
MYSQL_ROOT_PASSWORD=samplerootpassword
MYSQL_PASSWORD=samplemysqlpassword
NEXTCLOUD_ADMIN_USER=sysadmin
NEXTCLOUD_ADMIN_PASSWORD=sampleadminpassword
